# MarketLens - Environment Variables

# REQUIRED: JWT secret for web authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MLENS_JWT_SECRET=d7c02541c61a91fa9e5fc0f2a181101782a16d9a371014b39e126489c3451077

# Data and output directories (defaults to ./data and ./output)
# MLENS_DATA_DIR=./data
# MLENS_OUTPUT_DIR=./output

# CORS allowed origins (comma-separated)
# MLENS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Cookie security (set to "true" in production with HTTPS)
# MLENS_COOKIE_SECURE=false

# Database path (defaults to <data_dir>/marketlens.db)
# MLENS_DB_PATH=./data/marketlens.db

# Log level
# MLENS_LOG_LEVEL=INFO

# API Keys (optional - for enhanced data collection)
TIKTOK_API_KEY=
PINTEREST_API_KEY=
PINTEREST_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Helium 10 / Jungle Scout (optional)
HELIUM10_API_KEY=
JUNGLESCOUT_API_KEY=

# Alibaba API (optional - for supplier cost estimates)
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# Keepa API (optional - for price history)
KEEPA_API_KEY=

# Configuration overrides
# API_MIN_PROFIT_MARGIN=30.0
# API_MAX_COMPETITION=50
# API_LOG_LEVEL=INFO
# API_OUTPUT_DIR=./output
